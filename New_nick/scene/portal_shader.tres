code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform float ColorIntense;
uniform vec4 PortalColor : source_color;
uniform sampler2D tex_frg_8 : source_color;
uniform sampler2D tex_frg_7 : source_color;



void fragment() {
// FloatParameter:11
	float n_out11p0 = ColorIntense;


// ColorParameter:9
	vec4 n_out9p0 = PortalColor;


// VectorOp:12
	vec4 n_out12p0 = vec4(n_out11p0) * n_out9p0;


	vec2 n_out3p0;
// UVPolarCoord:3
	vec2 n_in3p1 = vec2(0.50000, 0.50000);
	float n_in3p2 = 2.00000;
	float n_in3p3 = 2.00000;
	{
		vec2 __dir = UV - n_in3p1;
		float __radius = length(__dir) * 2.0;
		float __angle = atan(__dir.y, __dir.x) * 1.0 / (PI * 2.0);
		n_out3p0 = vec2(__radius * n_in3p2, __angle * n_in3p3);
	}


// Input:5
	float n_out5p0 = TIME;


// VectorOp:6
	vec2 n_in6p1 = vec2(-0.50000, 0.50000);
	vec2 n_out6p0 = vec2(n_out5p0) * n_in6p1;


// UVFunc:4
	vec2 n_in4p1 = vec2(1.00000, 1.00000);
	vec2 n_out4p0 = n_out6p0 * n_in4p1 + n_out3p0;


// Texture2D:8
	vec4 n_out8p0 = texture(tex_frg_8, n_out4p0);
	float n_out8p1 = n_out8p0.r;


// VectorOp:10
	vec4 n_out10p0 = n_out12p0 * vec4(n_out8p1);


// Texture2D:7
	vec4 n_out7p0 = texture(tex_frg_7, UV);
	float n_out7p1 = n_out7p0.r;


// Output:0
	ALBEDO = vec3(n_out10p0.xyz);
	ALPHA = n_out7p1;


}
"
