[node name="Footer" type="HBoxContainer" parent="MarginContainer/Credits/Credits" unique_id=294100951]
layout_mode = 2

[node name="Label" type="Label" parent="MarginContainer/Credits/Credits/Footer" unique_id=1728515576]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 0
text = "Entangled studios were formed during a semester of the 
Game Development minor at The Hague University of Applied Sciences. 
What started as a student project grew into a shared ambition to create
memorable and immersive gaming experiences. 
`Ripples of the Past` is our first step on that journey, 
and we hope you enjoyed playing it as much as we enjoyed creating it."
label_settings = SubResource("LabelSettings_ujxr8")
horizontal_alignment = 1
vertical_alignment = 1
metadata/_edit_use_anchors_ = true

[node name="Label2" type="Label" parent="MarginContainer/Credits/Credits/Footer" unique_id=539930310]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 0
text = "With the conclusion of the Game Development minor, many of the 
original team members have moved on. Continued development of 
this project will be led by Laura and Sawanthi. All intellectual property 
rights, creative ownership, and contributions made throughout 
the project's development remain the property of their respective 
original creators and members of Entangled Studios. 
Future development will continue with respect for and 
acknowledgment of those contributions."
label_settings = SubResource("LabelSettings_ujxr8")
horizontal_alignment = 1
vertical_alignment = 1
metadata/_edit_use_anchors_ = true

