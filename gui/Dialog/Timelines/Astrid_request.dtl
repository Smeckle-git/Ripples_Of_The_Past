[style]
if {Astrid.ask_for_help} == 1:
	[background arg="res://gui/Dialog/styles/Screenshot 2025-01-16 at 14.26.00.png" fade="10.0"]
	[wait_input]
	join Thorinn leftmost
	join Astrid rightmost
	Astrid: Thorinn! We need your help! Five villagers... they've fallen very ill, we’re afraid they’re dying. It's like a curse!
	Thorinn: A curse? What do you know of it?
	Astrid: Not much, but ... there is someone who might hel-..... no, i shouldn’t!
	Thorinn: What is it Astrid? Who are you talking about?
