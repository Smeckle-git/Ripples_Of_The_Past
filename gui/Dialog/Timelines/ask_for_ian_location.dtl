[style name="Interaction_Style"]
join Thorinn leftmost
if {temp_variable} == 0:
	Thorinn: *knocks* anyone home?
	[wait time="1.0" hide_text="false"]
	Thorinn: no reaction
	set {temp_variable} = 1
elif {temp_variable} == 1:
	Thorinn: excuse me. I'm looking for the local pharmacist. can you tell me the way?
	Go away you outsider!
	Thorinn: Someone seems to have a bad day.
	set {temp_variable} = 2
elif {temp_variable} == 2:
	Thorinn: Hello? Can you please guide me to the local pharmacist?
	He lives above his clinic in the hose over the river. Now leave please.
	Thorinn: Okay, fine. thank you.
	set {Ian.can_talk_to_ian} = true
