join Thorinn left [animation="Fade In Up" wait="true"]
join Whiskers right [animation="Fade In Up" length="1.0" wait="true"]
if {Whiskers.Forest_Interaction_phase} == 1:
	if {Whiskers.New_Dialog} == true:
		Thorinn: Poor kitty. All by himself, cold and hungry. Come here!
		Whiskers: Meow
		Thorinn: Look at you! For such a small animal you have really big Whiskers!
		Thorinn: Hmm, Whiskers I like that! That would be your name. Do you like it?
		Whiskers: Meow
		*Whiskers seems satisfied and decides to follow you.*
		set {Whiskers.New_Dialog} = false
	else:
		Whiskers: Meow
elif {Whiskers.Forest_Interaction_phase} == 2:
	if {Whiskers.New_Dialog} == true:
		Thorinn: Hey Whiskers, You know what is funny?
		Whiskers: Meow?
		Thorinn: Even though i just met you, i feel like i known you forever.
		Whiskers: I know, right!
		Thorinn: ...
		Thorinn: AAAAAAAAAAH!
		Thorinn: You can talk?! What?! Am I hallucinating?
		Whiskers: Thorinn! Relax, don’t be scared.
		Whiskers: I can only communicate with you,  you are the only one that will understand me.
		Whiskers: I am not able to reveal why. At least not now...
		Whiskers: Don’t worry, i will be your friend, I will keep you company on this journey
	else:
		Whiskers: we should move on
		Thorinn: First a god. Now a talking cat. What else can there be?
		Whiskers: Meow
else:
	Whiskers: Meow
