; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ripples_Of_The_Past"
config/version="Beta Build 0.0.1"
run/main_scene="res://scenes/ui/MainMenu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://assets/images/icon.svg"

[autoload]

Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"
GameHudManager="*res://scenes/ui/game_hud_manager.tscn"
InteractManager="*res://scenes/ui/InteractManager.tscn"
GameSettingsManager="*res://autoload/GameSettingsManager.gd"
SceneManager="*res://scenes/Levels/scene_manager.tscn"
KarmaGlobal="*res://Scripts/Karma_global.gd"

[dialogic]

directories/dch_directory={
"Barbarian": "res://gui/Dialog/Characters/Barbarian.dch",
"Hugo": "res://gui/Dialog/Characters/Hugo.dch",
"Ian": "res://gui/Dialog/Characters/Ian.dch",
"Mage": "res://gui/Dialog/Characters/Mage.dch",
"Thorinn": "res://gui/Dialog/Characters/Thorinn.dch",
"Whiskers": "res://gui/Dialog/Characters/Whiskers.dch",
"vivian": "res://gui/Dialog/Timelines/vivian.dch"
}
directories/dtl_directory={
"DEMO_interaction": "res://gui/Dialog/Timelines/DEMO_interaction.dtl",
"Fish_quest_completion": "res://gui/Dialog/Timelines/Fish_quest_completion.dtl",
"Iann_interaction": "res://gui/Dialog/Timelines/Iann_interaction.dtl",
"ask_for_ian_location": "res://gui/Dialog/Timelines/ask_for_ian_location.dtl",
"flower_girl_quest": "res://gui/Dialog/Timelines/flower_girl_quest.dtl",
"quest1_end": "res://gui/Dialog/Timelines/quest1_end.dtl",
"quest1_start": "res://gui/Dialog/Timelines/quest1_start.dtl",
"thorinn_hugo_forest": "res://gui/Dialog/Timelines/thorinn_hugo_forest.dtl",
"thorinn_meets_whiskers": "res://gui/Dialog/Timelines/thorinn_meets_whiskers.dtl",
"thorinn_whiskers_forest": "res://gui/Dialog/Timelines/thorinn_whiskers_forest.dtl",
"wiskers_start_campfire_quest": "res://gui/Dialog/Timelines/wiskers_start_campfire_quest.dtl"
}
variables={
"Hugo": {
"Followed_to_rockfall": false
},
"Ian": {
"can_talk_to_ian": false,
"find_ian_quest_avalible": false
},
"Vivian": {
"Interaction_phase": 1,
"New_Dialog": true,
"flower_quest_accepted": false
},
"Whiskers": {
"Forest_Interaction_phase": 1,
"New_Dialog": true,
"Selected_Option": 0
},
"temp_variable": 0
}
layout/style_list=["res://gui/Dialog/Interaction_Style.tres"]
layout/default_style="Default"
glossary/default_case_sensitive=true
extensions_folder="res://addons/dialogic_additions"
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={}

[dotnet]

project/assembly_name="Ripples_Of_The_Past"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg", "res://addons/terrain_3d/plugin.cfg")

[filesystem]

import/blender/enabled=false

