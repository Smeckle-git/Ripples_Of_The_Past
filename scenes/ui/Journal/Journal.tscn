[node name="Label2" type="Label" parent="MarginContainer2/VBoxContainer/TabContainer/Characters/TabContainer/Thorin/HBoxContainer"]
custom_minimum_size = Vector2(250, 0)
layout_mode = 2
text = "Thorinn is a complicated and mysterious man, walking the fine line between good and bad. 

He is a skilled doctor who saves lives and provides aid. He does what needs to be done, and many are grateful for his help, even if he isn’t the warmest person.
"
autowrap_mode = 2

[node name="HBoxContainer2" type="VBoxContainer" parent="MarginContainer2/VBoxContainer/TabContainer/Characters/TabContainer/Thorin"]
layout_mode = 2
offset_left = 302.0
offset_top = 58.0
offset_right = 642.0
offset_bottom = 458.0
scale = Vector2(1.03087, 1.0651)

[node name="Label2" type="Label" parent="MarginContainer2/VBoxContainer/TabContainer/Characters/TabContainer/Thorin/HBoxContainer2"]
custom_minimum_size = Vector2(250, 0)
layout_mode = 2
text = "Despite his coldness, small acts of kindness suggest an inner conflict, leaving many to wonder whether he is truly a good man or just someone surviving in a harsh world.

He rarely speaks of his past, but it’s clear he carries a burden. "
autowrap_mode = 2

[node name="Wiskers" type="TabBar" parent="MarginContainer2/VBoxContainer/TabContainer/Characters/TabContainer"]
visible = false
layout_mode = 2
metadata/_tab_index = 1

[node name="HBoxContainer" type="VBoxContainer" parent="MarginContainer2/VBoxContainer/TabContainer/Characters/TabContainer/Wiskers"]
offset_left = -64.0
offset_top = 10.0
offset_right = 254.0
offset_bottom = 459.0
scale = Vector2(1.03087, 1.0651)

[node name="Label2" type="Label" parent="MarginContainer2/VBoxContainer/TabContainer/Characters/TabContainer/Wiskers/HBoxContainer"]
custom_minimum_size = Vector2(250, 0)
layout_mode = 2
text = "Thorinn’s most loyal companion is a cheeky, talking cat that only he can hear, this is a secret no one else knows. The cat follows him everywhere.
With a sharp tongue and a playful attitude, the cat loves teasing Thorinn and offering sly advice. 

"
autowrap_mode = 2

[node name="HBoxContainer2" type="VBoxContainer" parent="MarginContainer2/VBoxContainer/TabContainer/Characters/TabContainer/Wiskers"]
offset_left = 304.0
offset_top = 74.0
offset_right = 644.0
offset_bottom = 474.0
scale = Vector2(1.03087, 1.0651)

[node name="Label2" type="Label" parent="MarginContainer2/VBoxContainer/TabContainer/Characters/TabContainer/Wiskers/HBoxContainer2"]
custom_minimum_size = Vector2(250, 0)
layout_mode = 2
text = "Despite his mischief, he’s very loyal and always watches Thorinn’s back.

To others, he’s just an ordinary stray, but to Thorinn, he’s a trusted ally and perhaps the only one who truly understands him."
autowrap_mode = 2

[node name="Hugo" type="TabBar" parent="MarginContainer2/VBoxContainer/TabContainer/Characters/TabContainer"]
visible = false
layout_mode = 2
metadata/_tab_index = 2

[node name="HBoxContainer" type="VBoxContainer" parent="MarginContainer2/VBoxContainer/TabContainer/Characters/TabContainer/Hugo"]
offset_left = -60.0
offset_top = 7.0
offset_right = 258.0
offset_bottom = 454.0
scale = Vector2(1.03087, 1.0651)

[node name="Label2" type="Label" parent="MarginContainer2/VBoxContainer/TabContainer/Characters/TabContainer/Hugo/HBoxContainer"]
custom_minimum_size = Vector2(250, 0)
layout_mode = 2
text = "Hugo is a charming and friendly person, always smiling, always listening. He has a way of making others feel comfortable, encouraging them to talk while he simply listens. 

Everyone finds themselves opening up to him without even realising it."
autowrap_mode = 2

[node name="HBoxContainer2" type="VBoxContainer" parent="MarginContainer2/VBoxContainer/TabContainer/Characters/TabContainer/Hugo"]
offset_left = 305.0
offset_top = 77.0
offset_right = 645.0
offset_bottom = 477.0
scale = Vector2(1.03087, 1.0651)

[node name="Label2" type="Label" parent="MarginContainer2/VBoxContainer/TabContainer/Characters/TabContainer/Hugo/HBoxContainer2"]
custom_minimum_size = Vector2(250, 0)
layout_mode = 2
text = "He knows all the gossip, all the secrets, and is always the first to hear the latest news. 

Despite his open and cheerful nature, no one really knows much about him. He never talks about himself, always steering conversations away from his own life."
autowrap_mode = 2

[node name="Ian" type="TabBar" parent="MarginContainer2/VBoxContainer/TabContainer/Characters/TabContainer"]
layout_mode = 2
metadata/_tab_index = 3

[node name="HBoxContainer" type="VBoxContainer" parent="MarginContainer2/VBoxContainer/TabContainer/Characters/TabContainer/Ian"]
offset_left = -60.0
offset_top = 7.0
offset_right = 258.0
offset_bottom = 454.0
scale = Vector2(1.03087, 1.0651)

[node name="Label2" type="Label" parent="MarginContainer2/VBoxContainer/TabContainer/Characters/TabContainer/Ian/HBoxContainer"]
custom_minimum_size = Vector2(250, 0)
layout_mode = 2
text = "Ian never knew Thorinn as a young man, but he grew up hearing stories about the genius student who had once studied under their shared master.

Thorinn’s achievements always seemed to outshine his own, and Ian always felt inferior about the praise his master had given Thorinn."
autowrap_mode = 2

[node name="HBoxContainer2" type="VBoxContainer" parent="MarginContainer2/VBoxContainer/TabContainer/Characters/TabContainer/Ian"]
offset_left = 301.0
offset_top = 50.0
offset_right = 641.0
offset_bottom = 450.0
scale = Vector2(1.03087, 1.0651)

[node name="Label2" type="Label" parent="MarginContainer2/VBoxContainer/TabContainer/Characters/TabContainer/Ian/HBoxContainer2"]
custom_minimum_size = Vector2(250, 0)
layout_mode = 2
text = "When Ian finally meets Thorinn, his envy is immediate, and his resentment is clear.  From the very beginning, Ian is antagonistic, constantly challenging and trying to provoke Thorinn, driven by jealousy and a need to prove himself in comparison to the “great” student from the past."
autowrap_mode = 2

